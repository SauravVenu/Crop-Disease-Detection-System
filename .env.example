# KRISHISEV Server Environment Configuration
# Copy this file to .env and fill in your keys

# Google Gemini API Key for expert agronomy chatbot
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps JavaScript API Key (optional, falls back to offline mockup view if empty)
GOOGLE_MAPS_API_KEY=

# Firebase Web App API Key (required for Firestore database connectivity)
FIREBASE_API_KEY=your_firebase_api_key_here
